def fibo_rec(x){
    if( x == 0 || x == 1){
        return x;
    };
    return fibo_rec(x-1) + fibo_rec(x-2);
};
print("function fibo recursive");
print(fibo_rec(9));

def fibo(n,som,som2){
    if(n != 1){
        return fibo(n-1,som+som2,som);
    };
    return som;
};
print("function fibo recursive terminale");
print(fibo(9,1,0));


